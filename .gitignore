# ==============================================================================
# Varun Industries — Git Ignore Rules
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Output
/.next/
/out/
build/
dist/

# TypeScript & Build Info
*.tsbuildinfo
next-env.d.ts

# Sensitive Environment Variables (NEVER commit secrets to version control)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package Manager Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor Directories
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# User Uploaded Content & Media (Keep directory structure, exclude uploaded files)
/public/uploads/**
!/public/uploads/
!/public/uploads/**/
!/public/uploads/**/.gitkeep

# Temporary Caches
.turbo/
*.tmp
*.temp
