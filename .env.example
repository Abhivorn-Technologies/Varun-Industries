# Copy to .env.local for local development, and set the same values in your
# hosting provider's environment settings for production. Never commit real values.

# Public URL of the live site, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact form email delivery (server-side only, never exposed to the browser) ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=the Gmail address, SMTP_PASS=a Google "App password" (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Address that receives enquiries (defaults to the company email if left empty).
ENQUIRY_TO=
# Address that receives job applications (defaults to ENQUIRY_TO or company email if left empty).
CAREERS_TO=
# Sender address shown on enquiry emails (defaults to SMTP_USER if left empty).
ENQUIRY_FROM=

# --- Optional bot protection: Cloudflare Turnstile ---
# Leave both empty to rely on the built-in honeypot, timing check and rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional analytics: Google Analytics 4 ---
# When set, a cookie consent banner is shown and analytics loads only after the visitor accepts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
