# ==============================================================================
# Varun Industries Website — Environment Variables Template
#
# Instructions:
# 1. Copy this file to '.env.local' for local development:
#    cp .env.example .env.local
# 2. Fill in your real database credentials, SMTP email credentials, and admin secret.
# 3. For Vercel, Netlify, or VPS deployment, add these variables in your hosting dashboard.
# 4. NEVER commit '.env.local' or real secrets to your GitHub repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Site Configuration
# ------------------------------------------------------------------------------
# Canonical URL of the website (used for SEO, OpenGraph, sitemap.xml, robots.txt)
# Example: https://www.varun-industries.com or http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.varun-industries.com

# ------------------------------------------------------------------------------
# 2. MongoDB Database Connection
# ------------------------------------------------------------------------------
# Standard MongoDB connection string (local or MongoDB Atlas)
# Atlas Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name in MongoDB
MONGODB_DB=varun_industries

# ------------------------------------------------------------------------------
# 3. Admin Authentication & Security (/admin)
# ------------------------------------------------------------------------------
# Default credentials for first-time admin setup (change immediately after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# Secret key used for signing and verifying secure JWT session cookies.
# Generate a random 32+ character string in production (e.g. openssl rand -base64 32)
ADMIN_SECRET=generate_a_secure_random_32_character_string_for_production

# ------------------------------------------------------------------------------
# 4. Email Delivery (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# Server-side SMTP credentials for sending contact enquiries and job applications.
# If using Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-google-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Email address where client enquiries should be forwarded
ENQUIRY_TO=sales@varun-industries.com

# Email address where career candidate applications should be forwarded
CAREERS_TO=hr@varun-industries.com

# Display sender address (defaults to SMTP_USER if left empty)
ENQUIRY_FROM=

# ------------------------------------------------------------------------------
# 5. Anti-Bot Protection: Cloudflare Turnstile (Optional)
# ------------------------------------------------------------------------------
# If left empty, built-in honeypot, timing validation, and IP rate limiting are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. Analytics: Google Analytics 4 (Optional)
# ------------------------------------------------------------------------------
# When provided, cookie consent banner activates and tracks page views.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
